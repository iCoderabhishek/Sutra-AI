generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  googleId  String   @unique
  agents    Agent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agent {
  id          String   @id @default(uuid())
  name        String
  desc        String
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?
  prompt      Json
  instruction Json
  tools       String[]
  schedule    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
