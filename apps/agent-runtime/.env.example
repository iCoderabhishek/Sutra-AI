# FastAPI Configuration
PORT=8000

# =========================
# INFRA — must match apps/backend/.env
REDIS_PASSWORD=
REDIS_PORT=6381
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6381

# =========================
# AUTH — >=32 chars or the service refuses to boot.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_SHARED_SECRET=

# =========================
# API KEYS
GEMINI_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# =========================
# SMTP — Gmail app password, not your account password.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# =========================
# Default system prompt, used when an agent has no template/prompt of its own.
SYSTEM_PROMPT=""
