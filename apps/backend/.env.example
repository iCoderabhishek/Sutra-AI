# APP CONFIGS
PORT=4000

# =========================
# INFRA — these values must match apps/agent-runtime/.env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=sutra
POSTGRES_PORT=5435
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5435/sutra

REDIS_PASSWORD=
REDIS_PORT=6381
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6381

# =========================
# AGENT RUNTIME
# http://agent-runtime:8000 inside Docker, http://localhost:8000 on the host.
AGENT_BACKEND_URL=http://agent-runtime:8000
# >=32 chars, byte-identical to the runtime's value.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_SHARED_SECRET=

# =========================
# SESSION
SESSION_SECRET=

# =========================
# OAUTH CREDENTIALS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/callback
